{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/$1" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "CF_ENV": "production",
    "CF_SERVERLESS": "1"
  }
}
